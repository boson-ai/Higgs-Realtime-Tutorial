# Your Boson API key. It stays in the worker; clients never see it.
BOSON_API_KEY=

# The LiveKit server. These are livekit-server --dev's built-ins.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional. The defaults are the public production endpoint and models.
# BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime/
# BOSON_REALTIME_MODEL=higgs-realtime
# BOSON_VOICE=default
# BOSON_CAPTION_MODEL=higgs-stt-3.1

# Optional. Set it and web_search searches the real web with Parallel
# (parallel.ai) instead of the fictional Willow Creek index.
# PARALLEL_API_KEY=
