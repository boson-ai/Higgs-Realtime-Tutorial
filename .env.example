# Your Boson AI API key. The token server uses it to mint short-lived ephemeral
# keys for the browser. It is never sent to the browser itself.
#
# Provide the key ONE of two ways:
#   1. Inline (takes precedence):
#        BOSON_API_KEY=bai-...
#   2. From a file — point at wherever you already keep the key:
#        BOSON_API_KEY_FILE=/path/to/your/bosonapi_key
#
# Copy this file to .env and fill one of them in. .env is gitignored.
BOSON_API_KEY=
# BOSON_API_KEY_FILE=

# Optional overrides
# PORT=3000
# BOSON_BASE_URL=https://api.boson.ai
