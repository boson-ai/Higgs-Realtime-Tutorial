# Your Boson API key. It stays in this process; the browser never sees it.
BOSON_API_KEY=

# Optional. The defaults are the public production endpoints and models.
# BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime/
# BOSON_REALTIME_MODEL=higgs-realtime
# BOSON_TTS_MODEL=higgs-realtime-tts
# BOSON_VOICE=default
# BOSON_CAPTION_MODEL=higgs-stt-3.1

# Part 7 only: the LiveKit server. These are livekit-server --dev's built-ins.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
